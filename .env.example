# Copy to .env and fill in the values. Never commit .env.

# --- Database (local docker compose) ---
POSTGRES_USER=tuition
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tuition
# Local: postgres service in compose. AWS: the RDS endpoint.
DATABASE_URL=postgresql+psycopg://tuition:change-me@postgres:5432/tuition

# --- Auth ---
# Shared by the Tuition API (signing) and Kong (verification). Use a long random value.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MIN=60

# --- Agent / LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest,gemini-2.5-flash-lite

# --- Internal service URLs (compose network) ---
GATEWAY_URL=http://kong:8000
MCP_URL=http://mcp-server:8100/mcp

# --- Gateway ---
# Host port for Kong locally (the only public port). AWS uses 80.
GATEWAY_PORT=80

# --- AWS only (docker-compose.prod.yml) ---
# Domain whose A record points at the Elastic IP; Caddy gets a Let's Encrypt certificate for it.
# Leave empty to serve by IP over plain HTTP.
PUBLIC_DOMAIN=
