{
  "openapi": "3.1.0",
  "info": {
    "title": "Tuition API",
    "description": "University tuition query, payment and administration API (v1).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe",
        "description": "The process is up. Does not touch the database.",
        "operationId": "liveness_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Liveness Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness probe (checks the database)",
        "operationId": "readiness_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Readiness Api V1 Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in and get a JWT",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or token"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Who am I (decoded token)",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or token"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/mobile/tuition/{studentNo}": {
      "get": {
        "tags": [
          "Mobile App"
        ],
        "summary": "Query tuition (no auth, 3 calls per student per day at the gateway)",
        "operationId": "query_tuition_mobile_api_v1_mobile_tuition__studentNo__get",
        "parameters": [
          {
            "name": "studentNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,16}$",
              "examples": [
                "S1001"
              ],
              "title": "Studentno"
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(FALL|SPRING)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-FALL or YYYY-SPRING; omit for the overall balance",
              "examples": [
                "2026-FALL"
              ],
              "title": "Term"
            },
            "description": "YYYY-FALL or YYYY-SPRING; omit for the overall balance"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TuitionSummary"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (gateway)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/banking/tuition/{studentNo}": {
      "get": {
        "tags": [
          "Banking App"
        ],
        "summary": "Query tuition (bank: any student, student: own records only)",
        "operationId": "query_tuition_banking_api_v1_banking_tuition__studentNo__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "studentNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,16}$",
              "examples": [
                "S1001"
              ],
              "title": "Studentno"
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(FALL|SPRING)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-FALL or YYYY-SPRING; omit for the overall balance",
              "examples": [
                "2026-FALL"
              ],
              "title": "Term"
            },
            "description": "YYYY-FALL or YYYY-SPRING; omit for the overall balance"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TuitionSummary"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed for this user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/banking/payments": {
      "post": {
        "tags": [
          "Banking App"
        ],
        "summary": "Pay tuition (simulated; full or partial, no overpayment, idempotent transactionId)",
        "operationId": "create_payment_api_v1_banking_payments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed for this user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/admin/tuition": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Add or update tuition for a student and term (201 CREATED / 200 UPDATED)",
        "operationId": "create_or_update_tuition_api_v1_admin_tuition_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTuitionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddTuitionResponse"
                }
              }
            }
          },
          "200": {
            "description": "Existing record updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddTuitionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed for this user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/admin/tuition/batch": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Add tuition from a CSV file (header: studentNo,term,amount,currency)",
        "operationId": "upload_tuition_batch_api_v1_admin_tuition_batch_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_tuition_batch_api_v1_admin_tuition_batch_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed for this user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/admin/tuition/unpaid": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Paged list of students with an unpaid balance for a term",
        "operationId": "list_unpaid_api_v1_admin_tuition_unpaid_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-(FALL|SPRING)$",
              "examples": [
                "2026-FALL"
              ],
              "title": "Term"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Pagesize"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnpaidPage"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed for this user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddTuitionRequest": {
        "properties": {
          "studentNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,16}$",
            "title": "Studentno",
            "examples": [
              "S1004"
            ]
          },
          "term": {
            "type": "string",
            "pattern": "^[0-9]{4}-(FALL|SPRING)$",
            "title": "Term",
            "examples": [
              "2027-SPRING"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "3000.00"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "description": "ISO-4217 code",
            "default": "USD",
            "examples": [
              "USD"
            ]
          }
        },
        "type": "object",
        "required": [
          "studentNo",
          "term",
          "amount"
        ],
        "title": "AddTuitionRequest"
      },
      "AddTuitionResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "CREATED or UPDATED",
            "examples": [
              "CREATED"
            ]
          },
          "studentNo": {
            "type": "string",
            "title": "Studentno"
          },
          "term": {
            "type": "string",
            "title": "Term"
          },
          "amount": {
            "type": "string",
            "title": "Amount",
            "example": "3000.00"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "previousAmount": {
            "anyOf": [
              {
                "type": "string",
                "example": "3000.00"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previousamount",
            "description": "Only for UPDATED"
          }
        },
        "type": "object",
        "required": [
          "status",
          "studentNo",
          "term",
          "amount",
          "currency"
        ],
        "title": "AddTuitionResponse"
      },
      "BatchResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "COMPLETED (no failures), PARTIAL or FAILED (no successes)"
          },
          "totalRows": {
            "type": "integer",
            "title": "Totalrows"
          },
          "successCount": {
            "type": "integer",
            "title": "Successcount"
          },
          "failureCount": {
            "type": "integer",
            "title": "Failurecount"
          },
          "createdCount": {
            "type": "integer",
            "title": "Createdcount"
          },
          "updatedCount": {
            "type": "integer",
            "title": "Updatedcount"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/BatchRowError"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "status",
          "totalRows",
          "successCount",
          "failureCount",
          "createdCount",
          "updatedCount",
          "errors"
        ],
        "title": "BatchResponse"
      },
      "BatchRowError": {
        "properties": {
          "row": {
            "type": "integer",
            "title": "Row",
            "description": "Line number in the CSV file (the header is line 1)"
          },
          "studentNo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Studentno"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "row",
          "studentNo",
          "code",
          "reason"
        ],
        "title": "BatchRowError"
      },
      "Body_upload_tuition_batch_api_v1_admin_tuition_batch_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "UTF-8 CSV file"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_tuition_batch_api_v1_admin_tuition_batch_post"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "STUDENT_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "examples": [
              "s1001"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "examples": [
              "Pass1001!"
            ]
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MeResponse": {
        "properties": {
          "userId": {
            "type": "integer",
            "title": "Userid"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "studentNo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Studentno"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "username",
          "role",
          "studentNo"
        ],
        "title": "MeResponse"
      },
      "PaymentRequest": {
        "properties": {
          "studentNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,16}$",
            "title": "Studentno",
            "examples": [
              "S1001"
            ]
          },
          "term": {
            "type": "string",
            "pattern": "^[0-9]{4}-(FALL|SPRING)$",
            "title": "Term",
            "examples": [
              "2026-FALL"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "description": "Positive, at most 2 decimals; send it as a string",
            "examples": [
              "500.00"
            ]
          },
          "transactionId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Transactionid",
            "description": "Client-generated idempotency key",
            "examples": [
              "TX-2026-0001"
            ]
          }
        },
        "type": "object",
        "required": [
          "studentNo",
          "term",
          "amount",
          "transactionId"
        ],
        "title": "PaymentRequest"
      },
      "PaymentResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "SUCCESS"
            ]
          },
          "transactionId": {
            "type": "string",
            "title": "Transactionid"
          },
          "studentNo": {
